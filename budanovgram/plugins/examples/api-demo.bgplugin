{
  "manifest": {
    "id": "bg.api-demo",
    "name": "Внешний API",
    "version": "1.0.0",
    "apiVersion": 1,
    "author": "BudanovGram",
    "description": "Пример HTTPS-запроса: информация о последнем релизе BudanovGram.",
    "permissions": [
      "network",
      "ui"
    ],
    "networkHosts": [
      "api.github.com"
    ],
    "settings": []
  },
  "script": "bg.commands.register({id:'release',title:'Проверить релиз через API',scope:'main'}, async () => {\n  const response = await bg.network.fetch('https://api.github.com/repos/Mengy777/BudanovGram/releases/latest');\n  if (!response.ok) throw new Error('HTTP '+response.status);\n  const data = await response.json();\n  await bg.ui.panel({id:'release',title:'GitHub API',text:`${data.name}\\n${data.html_url}\\n\\n${data.body || ''}`});\n});"
}
