# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Ensure diffs have LF endings
*.diff text eol=lf
*.bat text eol=crlf

# Keep the zxcvbn word lists byte-identical to upstream so their digests hold
Telegram/Resources/zxcvbn/*.txt text eol=lf

# Ensure lottie animations are treated as binary files
*.lottie binary

# Plugin package SHA-256 covers exact bytes, including line endings.
budanovgram/plugins/examples/*.bgplugin -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Upstream generated QuickJS headers retain their final blank line.
budanovgram/plugins/vendor/quickjs/builtin-*.h whitespace=-blank-at-eof
budanovgram/plugins/vendor/quickjs/libunicode-table.h whitespace=-blank-at-eof
